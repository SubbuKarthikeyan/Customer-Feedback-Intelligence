      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Classify this customer feedback email.\n\nSubject: {{ $json.subject }}\n\nBody: {{ $json.body }}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {
          "systemMessage": "=You are a customer feedback classifier and information extraction system. Read the customer email and respond ONLY with a valid JSON object. Use exactly these keys: { \"product\": null, \"feature\": null, \"issue\": null, \"sentiment\": \"neutral\", \"category\": \"other\", \"severity\": \"low\", \"summary\": \"\", \"suggestedAction\": \"\", \"confidence\": 0, \"reviewRequired\": false } Rules: 1. PRODUCT The supported products are: Chat Interface, Dashboard, E-commerce. Return the matching product when clearly mentioned or identifiable. If it cannot be determined, return null. Never invent a product. 2. FEATURE Extract the specific product feature/component involved (e.g. Checkout, Payment, Search, Login, File Upload, Conversation History, Export, Charts, Orders). If none is identifiable, return null. Never invent a feature. 3. ISSUE Extract the main problem, request, question, or subject in a short phrase. If none can be identified, return null. 4. SENTIMENT one of: positive, neutral, negative. 5. CATEGORY one of: bug, feature_request, complaint, praise, question, other. bug = something broken/failing/crashing/incorrect. feature_request = wants a new feature or improvement. complaint = dissatisfaction without the primary intent being a technical bug. praise = positive appreciation. question = asking for information. other = does not clearly fit. 6. SEVERITY one of: low, medium, high, critical. Use the actual impact described; do not raise severity for emotional language. 7. SUMMARY exactly one concise sentence using only information in the email. 8. SUGGESTED ACTION exactly one concise sentence describing the recommended next step; do not promise resolutions or dates. 9. CONFIDENCE a number 0 to 1. 10. REVIEW REQUIRED true if confidence below 0.80, or category/product cannot be determined reliably, or the email is ambiguous; false when classification is clear and confidence >= 0.80. IMPORTANT: Return ONLY the JSON object. No Markdown, no code fences, no explanations, no extra keys. Use null when information is unavailable. Do not guess or hallucinate.\n\nCustomer email subject: {{ $json.subject }}, body: {{ $json.body }}"
        }
      },
