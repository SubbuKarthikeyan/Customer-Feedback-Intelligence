    {
      "parameters": {
        "jsCode": "const g = $input.first().json;\nfunction extractText(o) {\n  if (o == null) return \"\";\n  if (typeof o === \"string\") return o;\n  if (typeof o.content === \"string\") return o.content;\n  if (o.content && Array.isArray(o.content.parts)) return o.content.parts.map(p => p && p.text ? p.text : \"\").join(\"\");\n  if (o.content && typeof o.content.text === \"string\") return o.content.text;\n  if (Array.isArray(o.parts)) return o.parts.map(p => p && p.text ? p.text : \"\").join(\"\");\n  if (typeof o.text === \"string\") return o.text;\n  if (o.message && typeof o.message.content === \"string\") return o.message.content;\n  return \"\";\n}\nlet narrative = String(extractText(g) || \"\").trim();\nconst agg = $(\"Aggregate Metrics\").first().json;\nfunction esc(s) { return String(s == null ? \"\" : s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nlet html = \"\";\nhtml += \"<h2>Customer Feedback Weekly Digest</h2>\";\nhtml += \"<p><strong>Week of \" + esc(agg.weekOf) + \"</strong></p>\";\nhtml += \"<p>Total feedback analyzed: \" + agg.total + \"</p>\";\nhtml += \"<h3>AI Trend Summary</h3><p>\" + esc(narrative).replace(/\\n/g, \"<br>\") + \"</p>\";\nhtml += \"<h3>Breakdown</h3><pre>\" + esc(agg.statsText) + \"</pre>\";\nconst items = agg.urgentItems || [];\nif (items.length) {\n  html += \"<h3>Urgent Items</h3><ul>\";\n  for (const it of items) {\n    html += \"<li><strong>\" + esc(it.subject) + \"</strong>: \" + esc(it.summary) + \" (\" + esc(it.severity) + \")</li>\";\n  }\n  html += \"</ul>\";\n}\nreturn [{ json: {\n  emailSubject: \"Customer Feedback Weekly Digest - \" + esc(agg.weekOf),\n  emailBody: html,\n  weekOf: agg.weekOf,\n  total: agg.total\n} }];"
      },
