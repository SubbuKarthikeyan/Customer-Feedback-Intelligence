    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $input.item.json;\n\n// Extract clean email address from From field\nlet from = \"\";\n\nif (typeof j.from === \"string\") {\n  from = j.from.match(/<([^>]+)>/)?.[1] || j.from.trim();\n}\nelse if (j.from?.value?.[0]) {\n  from = j.from.value[0].address || \"\";\n}\nelse if (j.from?.text) {\n  from = j.from.text.match(/<([^>]+)>/)?.[1] || j.from.text.trim();\n}\n\nconst rawBody = j.text || j.textAsHtml || j.snippet || \"\";\nconst body = String(rawBody)\n  .replace(/\\s+/g, \" \")\n  .trim()\n  .slice(0, 4000);\n\nreturn {\n  json: {\n    messageId: j.id || \"\",\n    threadId: j.threadId || \"\",\n    from: j.From,\n    subject: j.Subject || \"(no subject)\",\n    body: j.snippet || \"\",\n    receivedAt: j.date || j.internalDate || new Date().toISOString(),\n  }\n};"
      },
      "id": "d7200263-dd58-42f8-b41e-da48f0917d3e",
      "name": "Normalize Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
