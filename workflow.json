    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const g = $input.item.json;\n\nfunction extractText(o) {\n  if (o == null) return \"\";\n  if (typeof o === \"string\") return o;\n  if (typeof o.content === \"string\") return o.content;\n  if (o.content && Array.isArray(o.content.parts)) {\n    return o.content.parts.map(p => p && p.text ? p.text : \"\").join(\"\");\n  }\n  if (o.content && typeof o.content.text === \"string\") return o.content.text;\n  if (Array.isArray(o.parts)) {\n    return o.parts.map(p => p && p.text ? p.text : \"\").join(\"\");\n  }\n  if (typeof o.text === \"string\") return o.text;\n  if (o.message && typeof o.message.content === \"string\") return o.message.content;\n  return \"\";\n}\n\nlet summary = String(extractText(g) || \"\").trim();\n\nconst src = $(\"Validate Classification\").item.json;\nconst msg = $(\"Normalize Email\").item.json;\n\nfunction extractEmail(value) {\n  if (!value) return \"\";\n  if (typeof value === \"object\") {\n    if (Array.isArray(value)) value = value[0];\n    if (value?.address) return String(value.address).trim().toLowerCase();\n    if (value?.email) return String(value.email).trim().toLowerCase();\n    if (value?.text) value = value.text;\n    else value = JSON.stringify(value);\n  }\n  value = String(value).trim();\n  const match = value.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i);\n  return match ? match[0].toLowerCase() : \"\";\n}\n\nconst email = extractEmail(src.from);\n\nreturn {\n  json: {\n    messageId: msg.messageId,\n    from: email,\n    subject: \"Reply for the feedback\",\n    summary: summary || src.summary || \"\",\n  }\n};"
      },
