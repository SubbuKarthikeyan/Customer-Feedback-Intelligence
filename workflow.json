    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $input.item.json;\n\nfunction parseC(v) {\n  if (v == null) return null;\n  if (typeof v === \"string\") {\n    try { return JSON.parse(v); } catch (e) { return null; }\n  }\n  if (typeof v === \"object\") {\n    if (typeof v.text === \"string\") {\n      try { return JSON.parse(v.text); } catch (e) { return v; }\n    }\n    return v;\n  }\n  return null;\n}\n\nconst c =\n  parseC(j.content) ||\n  parseC(j.text) ||\n  parseC(j.message) ||\n  parseC(j.output) ||\n  parseC(j) ||\n  {};\n\nfunction norm(s, allowed, def = null) {\n  const v = String(s == null ? \"\" : s).toLowerCase().trim();\n  return allowed.includes(v) ? v : def;\n}\n\nfunction safeString(v, def = \"\") {\n  if (v == null) return def;\n  return typeof v === \"string\" ? v.trim() : String(v).trim();\n}\n\nconst src = $(\"Normalize Email\").item.json || {};\n\nconst validCategories = [\"bug\", \"feature_request\", \"complaint\", \"praise\", \"question\", \"other\"];\nconst category = norm(c.category, validCategories, \"other\");\nconst severity = norm(c.severity || c.priority, [\"low\", \"medium\", \"high\", \"critical\"], \"low\");\nconst sentiment = norm(c.sentiment, [\"positive\", \"neutral\", \"negative\"], \"neutral\");\n\nconst confidence =\n  typeof c.confidence === \"number\" && c.confidence >= 0 && c.confidence <= 1\n    ? c.confidence\n    : null;\n\nconst reviewRequired =\n  typeof c.reviewRequired === \"boolean\"\n    ? c.reviewRequired\n    : confidence === null || confidence < 0.80;\n\nreturn {\n  json: {\n    receivedAt: src.receivedAt || \"\",\n    from: safeString(src.from),\n    subject: safeString(src.subject),\n    body: safeString(src.body),\n    product: c.product ? safeString(c.product) : null,\n    feature: c.feature ? safeString(c.feature) : null,\n    issue: c.issue ? safeString(c.issue) : null,\n    sentiment,\n    category,\n    severity,\n    summary: safeString(c.summary),\n    suggestedAction: safeString(c.suggestedAction || c.suggested_action),\n    confidence,\n    reviewRequired,\n  }\n};"
      },
