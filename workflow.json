    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && Object.keys(r).length > 0);\nconst total = rows.length;\nfunction by(key) {\n  return rows.reduce((a, r) => {\n    const k = String(r[key] == null ? \"unknown\" : r[key]).toLowerCase() || \"unknown\";\n    a[k] = (a[k] || 0) + 1;\n    return a;\n  }, {});\n}\nconst sentiment = by(\"sentiment\");\nconst category = by(\"category\");\nconst priority = by(\"severity\");\nconst urgent = rows.filter(r => [\"urgent\", \"high\", \"critical\"].indexOf(String(r.severity || \"\").toLowerCase()) !== -1);\nconst lines = [];\nlines.push(\"Total feedback: \" + total);\nlines.push(\"Sentiment: \" + JSON.stringify(sentiment));\nlines.push(\"Category: \" + JSON.stringify(category));\nlines.push(\"Severity: \" + JSON.stringify(priority));\nreturn [{ json: {\n  total: total,\n  sentiment: sentiment,\n  category: category,\n  priority: priority,\n  urgentCount: urgent.length,\n  statsText: lines.join(\"\\n\"),\n  urgentItems: urgent.slice(0, 20).map(r => ({ subject: r.subject, summary: r.summary, severity: r.severity })),\n  weekOf: new Date().toISOString().slice(0, 10),\n} }];"
      },
