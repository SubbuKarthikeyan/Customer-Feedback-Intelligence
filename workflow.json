    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const g = $input.item.json;\nfunction extractText(o) {\n  if (o == null) return \"\";\n  if (typeof o === \"string\") return o;\n  if (typeof o.content === \"string\") return o.content;\n  if (o.content && Array.isArray(o.content.parts)) return o.content.parts.map(p => p && p.text ? p.text : \"\").join(\"\");\n  if (o.content && typeof o.content.text === \"string\") return o.content.text;\n  if (Array.isArray(o.parts)) return o.parts.map(p => p && p.text ? p.text : \"\").join(\"\");\n  if (typeof o.text === \"string\") return o.text;\n  if (o.message && typeof o.message.content === \"string\") return o.message.content;\n  return \"\";\n}\nconst src = $(\"Validate Classification\").item.json;\nconst summaryText = String(extractText(g) || \"\").trim() || src.summary || \"\";\nfunction esc(s) { return String(s == null ? \"\" : s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); }\nconst date = src.receivedAt || \"\";\nconst subject = src.subject || \"(no subject)\";\nconst product = src.product || \"\";\nconst category = src.category || \"\";\nconst sentiment = src.sentiment || \"\";\nconst suggestedAction = src.suggestedAction || \"\";\nlet html = \"\";\nhtml += \"<h2>Customer Feedback Notification</h2>\";\nhtml += \"<p><strong>Date:</strong> \" + esc(date) + \"</p>\";\nhtml += \"<p><strong>Subject:</strong> \" + esc(subject) + \"</p>\";\nhtml += \"<p><strong>Product:</strong> \" + esc(product) + \"</p>\";\nhtml += \"<p><strong>Category:</strong> \" + esc(category) + \"</p>\";\nhtml += \"<p><strong>Sentiment:</strong> \" + esc(sentiment) + \"</p>\";\nhtml += \"<p><strong>Suggested Action:</strong> \" + esc(suggestedAction) + \"</p>\";\nhtml += \"<h3>Summary</h3><p>\" + esc(summaryText).replace(/\\n/g, \"<br>\") + \"</p>\";\nreturn { json: {\n  emailSubject: \"Customer Feedback [\" + category + \"] - \" + subject,\n  emailBody: html,\n  date: date,\n  subject: subject,\n  product: product,\n  category: category,\n  sentiment: sentiment,\n  suggestedAction: suggestedAction,\n  summary: summaryText\n} };"
      },
